#!/bin/bash
# version 2 - update permissions for folder /data
cd ~/bin
rm -rf n8n_server
wget https://github.com/mantonik/n8n_server/archive/refs/heads/cloudflare.zip
unzip cloudflare.zip 
rm -f cloudflare.zip
mv n8n_server-cloudflare n8n_server
chmod 755 ~/bin/n8n_server/bin/*.sh
#copy nginx files 
\cp -r ~/bin/n8n_server/server-config/data/nginx/* /data/nginx

echo "Update all .sh files with exec permissions"
find $HOME/bin/n8n_server/bin -name "*.sh" -exec chmod 755 {} \; -print
#chmod 755 ~/bin/n8n_server/bin/dockerfile/www_php_app/build.sh
#chmod 755 ~/bin/n8n_server/bin/dockerfile/nginx_php/*.sh

# Prepare for update 
rm /etc/nginx/conf.d/*.conf

echo "Copy server-config data to server configuration"
\cp -r n8n_server/server-config/* /data

#Setup permissions
echo "Update permissions for /data files directory 755, files 644"
find /data -type d -exec chmod 755 {} \; -print
find /data -type f -exec chmod 644 {} \; -print

find /usr/bin/*.sh -type f -exec chmod 755 {} \; -print

echo "-------------"
echo " Nginx version file:"
find /etc/nginx -name "*.conf" -exec sh -c 'echo "=== $1 ==="; grep "# Version: \|# ver: " "$1" 2>/dev/null || echo "No version found"' _ {} \;
echo "-------------"
echo "Restart nginx"
/bin/systemctl stop nginx.service
/bin/systemctl start nginx.service



echo "Deployment completed"